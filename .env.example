# ============================================================================
# .env.example — copy to .env.local and fill in values.
# .env* (except this file) is gitignored. NEVER commit real secrets.
#
# Env module: apps/web/src/lib/env.ts validates these at boot via
# @t3-oss/env-nextjs + zod. Set SKIP_ENV_VALIDATION=1 in CI builds that
# run without real secrets (e.g. type-check-only jobs).
# ============================================================================

# ── CI escape hatch ───────────────────────────────────────────────────────
# Set to 1 to skip env validation (e.g. in CI build without secrets).
# SKIP_ENV_VALIDATION=

# ── Runtime ──────────────────────────────────────────────────────────────
# Values: development | test | production
NODE_ENV=development

# ── App URL (Required-now) ────────────────────────────────────────────────
# The canonical URL of the web app. Used for absolute URL generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase DB + Auth (Required: Sprint 1) ───────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
# URL and publishable key are safe in browser bundles (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key is server-only — never expose to client bundles.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for migrations and background jobs).
DATABASE_URL=

# ── Stripe billing (Required: Day 26+) ────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Use sk_test_ / pk_test_ for dev; sk_live_ / pk_live_ for prod.
STRIPE_SECRET_KEY=
# Per-endpoint webhook secret from https://dashboard.stripe.com/webhooks
# Register the webhook endpoint as: {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Publishable key -- safe for browser bundles.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs for paid plans (from Stripe dashboard → Products).
# See docs/product/prd.md for plan definitions.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# ── Resend email (Required: Sprint 1–2) ───────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# Must match a verified Resend domain. Format: "Display Name <from@example.com>"
EMAIL_FROM="AI Workspace <noreply@example.com>"

# ── Sentry error tracking (Required: Sprint 1+) ───────────────────────────
# https://sentry.io/settings/<org>/projects/<project>/keys/
# Server-side DSN (used in server components, API routes, etc.)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional build-time token for source map upload. Server-only; never expose to the browser.
SENTRY_AUTH_TOKEN=
# Browser DSN (safe for client bundles — usually the same DSN).
NEXT_PUBLIC_SENTRY_DSN=

# ── PostHog analytics + feature flags (Required: Sprint 1+) ──────────────
# Browser SDK — project API key + ingestion host.
# https://us.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side personal API key for server-initiated events.
# https://us.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=

# ── Upstash Redis + QStash (Required: Sprint 3+) ─────────────────────────
# https://console.upstash.com — Redis REST endpoint + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# https://console.upstash.com/qstash — publishing token + signing keys.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Cloudflare R2 object storage (Required: Sprint 6) ────────────────────
# https://dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN URL for the R2 bucket (served via Cloudflare CDN).
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Anthropic LLM via Vercel AI SDK (Required: Sprint 8) ─────────────────
# https://console.anthropic.com/settings/keys — key starts with sk-ant-
ANTHROPIC_API_KEY=
# Optional: pin model + max-token ceiling for production safety.
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=4096
