# ============================================================================
# .env.example — copy to .env.local (web) or .env (server) and fill in.
# .env* (except this file) is gitignored. NEVER commit real secrets.
# ============================================================================
# Phase 0: nothing here is wired up yet. This file is the contract for what
# every layer of the locked stack (ADR 0001) will need.

# --- Runtime --------------------------------------------------------------
NODE_ENV=development

# --- Supabase (DB + Auth) -------------------------------------------------
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (for migrations, jobs)
DATABASE_URL=

# --- Stripe (billing) -----------------------------------------------------
# Test keys for dev; live keys for prod. Webhook secret is per-endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="AI Workspace <noreply@example.com>"

# --- Sentry (errors) ------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- PostHog (analytics + feature flags) ----------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=

# --- Upstash (Redis cache + rate limit + QStash jobs) ---------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Cloudflare R2 (object storage) ---------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Anthropic (LLM via Vercel AI SDK) ------------------------------------
ANTHROPIC_API_KEY=
# Optional: pin model + max-tokens defaults for prod safety.
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=4096

# --- App URLs -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
