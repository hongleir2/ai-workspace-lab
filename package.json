{
  "name": "indie-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Indie AI product monorepo. Apps live in apps/, shared code in packages/.",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.4.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @indie-lab/e2e test",
    "e2e:install": "pnpm --filter @indie-lab/e2e exec playwright install --with-deps",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@indie-lab/config": "workspace:*",
    "@types/node": "22.10.5",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
